generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  admin
  operator
  driver
}

enum EquipmentStatus {
  available
  rented
  maintenance
  inactive
}

enum BookingStatus {
  pending
  confirmed
  active
  completed
  cancelled
  rejected
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  refunded
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(customer)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  bookings     Booking[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  equipment Equipment[]

  @@map("categories")
}

model Equipment {
  id         String          @id @default(uuid()) @db.Uuid
  categoryId String          @map("category_id") @db.Uuid
  name       String
  status     EquipmentStatus @default(available)
  dailyRate  Decimal         @map("daily_rate") @db.Decimal(12, 2)
  location   String
  photoUrl   String?         @map("photo_url")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookings        Booking[]
  maintenanceLogs MaintenanceLog[]

  @@index([categoryId])
  @@index([status])
  @@map("equipment")
}

model Booking {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  equipmentId String        @map("equipment_id") @db.Uuid
  startDate   DateTime      @map("start_date") @db.Date
  endDate     DateTime      @map("end_date") @db.Date
  status      BookingStatus @default(pending)
  totalAmount Decimal?      @map("total_amount") @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments  Payment[]
  contract  Contract?

  @@index([equipmentId, startDate, endDate])
  @@index([userId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  bookingId     String        @map("booking_id") @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(pending)
  paymentMethod String?       @map("payment_method")
  paidAt        DateTime?     @map("paid_at")
  midtransOrderId String?     @map("midtrans_order_id")
  midtransToken String?       @map("midtrans_token")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model Contract {
  id        String    @id @default(uuid()) @db.Uuid
  bookingId String    @unique @map("booking_id") @db.Uuid
  docUrl    String?   @map("doc_url")
  signed    Boolean   @default(false)
  signedAt  DateTime? @map("signed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("contracts")
}

model MaintenanceLog {
  id          String   @id @default(uuid()) @db.Uuid
  equipmentId String   @map("equipment_id") @db.Uuid
  serviceDate DateTime @map("service_date") @db.Date
  notes       String
  cost        Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([equipmentId])
  @@index([serviceDate])
  @@map("maintenance_logs")
}
